{
  "cleanUrls": true,
  "routes": [
    {
      "src": "/downloads/(.*)",
      "headers": {
        "Content-Type": "application/vnd.android.package-archive",
        "Content-Disposition": "attachment; filename=\"SakhiNidhi.apk\""
      }
    },
    {
      "src": "/downloads/SakhiNidhi.apk",
      "dest": "/downloads/sakhinidhi.apk"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
