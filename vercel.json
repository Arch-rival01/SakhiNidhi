{
  "headers": [
    {
      "source": "/downloads/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"SakhiNidhi.apk\""
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/downloads/SakhiNidhi.apk",
      "destination": "/downloads/sakhinidhi.apk"
    },
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/download",
      "destination": "/index.html"
    },
    {
      "source": "/bank/:match*",
      "destination": "/index.html"
    },
    {
      "source": "/((?!downloads|icons|assets).*)",
      "destination": "/index.html"
    }
  ]
}
